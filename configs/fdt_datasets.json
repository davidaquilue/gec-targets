{
  "_comment": "The fdt_eeg datasets. Paths accept $ENV_VARS (e.g. $DATA_ROOT/UCM_MEG/...) so the same file can be used on the cluster.",
  "results_root": "D:/gec_targets_results",
  "n_jobs": 8,

  "datasets": {
    "UCM_AAL": {
      "_comment": "Source-reconstructed MEG, AAL. n_epochs = 38: fixed number of epochs per subject (fdt_eeg gec_diagnostics a3).",
      "loader": "bids_epochs",
      "root": "D:/UCM_MEG/bids_extended-AD",
      "epochs_dir": "epochs_AAL_SFREQ_250_EPLEN_4",
      "modality": "meg",
      "session": "resteyesclosed",
      "band": "alpha",
      "atlas": "AAL",
      "n_epochs": 38,
      "sc_path": "D:/ADNI_parcellated_data/connectomes/Skoch_et_al_2022/SC_AAL_avg_88HC.csv"
    },
    "UniRoma": {
      "_comment": "Channel-space EEG (30 channels): no SC, seeded random initialisation.",
      "loader": "bids_epochs",
      "root": "~/Desktop/EEG_datasets/EEG_UniRoma_FDT/BIDS",
      "epochs_dir": "epochs_SFREQ_256_EPLEN_1_own",
      "modality": "eeg",
      "session": "eyesclosed",
      "subject_prefix": "sub-",
      "participants_filter": {"classification": ["HC", "AD"]},
      "band": "alpha",
      "atlas": null,
      "sc_path": null
    },
    "ADNI_Schaefer400": {
      "_comment": "fMRI, already band-passed in preprocessing: band null. One 197-TR epoch per subject (split in time for split-half).",
      "loader": "bids_epochs",
      "root": "D:/ADNI Datasets/ADNI_BIDS/derivatives/fdt_project",
      "epochs_dir": "epochs_Schaefer400",
      "modality": "bold",
      "session": "M000",
      "band": null,
      "atlas": "Schaefer400",
      "sc_path": "D:/ADNI_parcellated_data/connectomes/HCP/SC_schaefer400_tian_S3_7Networks_32fold_groupconnectome_3T_MNI152NLin2009cAsym_2mm.csv"
    },
    "ADNI_Schaefer100": {
      "_comment": "TODO: epochs_Schaefer100 does not exist yet on D:/ (only epochs_Schaefer400).",
      "loader": "bids_epochs",
      "root": "D:/ADNI Datasets/ADNI_BIDS/derivatives/fdt_project",
      "epochs_dir": "epochs_Schaefer100",
      "modality": "bold",
      "session": "M000",
      "band": null,
      "atlas": "Schaefer100",
      "sc_path": "D:/ADNI_parcellated_data/connectomes/HCP/SC_schaefer100_tian_S1_7Networks_32fold_groupconnectome_3T_MNI152NLin2009cAsym_2mm.csv"
    }
  },

  "bands": {"theta": [4, 8], "alpha": [8, 13], "beta": [13, 30], "gamma": [30, 45]},

  "preprocessing": {"envelope": false, "orthogonalize": false, "tau": "FIT"},

  "models": {
    "legacy": {"sigma": 0.05, "maxC": 0.2, "use_abs": true,
               "eps_fc": 4e-4, "eps_fs": 1e-4},
    "network": {"sigma": 0.05, "theta": "FIT", "gamma": 0.8,
                "eps_fc": 1e-2, "eps_fs": 1e-1},
    "linear_hopf": {"_comment": "freqs_path: one value (Hz) per node; '{subject}' in the path selects a file per subject. TODO: compute.",
                    "sigma": 0.05, "maxC": 0.2, "a": -0.02,
                    "freqs_path": null,
                    "eps_fc": 4e-4, "eps_fs": 1e-4}
  },

  "fitting": {"max_iter": 5000, "tol": 1e-5, "check_every": 10,
              "convergence": "legacy", "log_every": 10, "n_init": 1,
              "seed": 0, "eps_fs_asym": 0.0, "split_half": false},

  "sweep": [
    {"_comment": "Study 2: fix eps_fc, vary eps_fs (and the reverse)",
     "datasets": ["UCM_AAL", "UniRoma", "ADNI_Schaefer400"],
     "models": ["network"],
     "grid": {"eps_fc": [0.003, 0.01, 0.03], "eps_fs": [0.03, 0.1, 0.3]}},
    {"_comment": "Study 3: models at their default settings",
     "datasets": ["UCM_AAL", "UniRoma", "ADNI_Schaefer400"],
     "models": ["legacy", "network"]}
  ]
}
