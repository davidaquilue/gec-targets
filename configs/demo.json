{
  "_comment": "Synthetic demo. Create the data first: python examples/make_synthetic_dataset.py demo_data. Paths are relative to this file.",
  "results_root": "../results_demo",
  "n_jobs": 4,

  "datasets": {
    "demo": {
      "loader": "bids_epochs",
      "root": "../demo_data",
      "epochs_dir": "epochs_demo",
      "modality": "eeg",
      "session": "rest",
      "band": null,
      "sc_path": "../demo_data/sc.csv"
    },
    "demo_channels": {
      "_comment": "Same data without SC: seeded random initialisation, as for channel-space EEG.",
      "loader": "bids_epochs",
      "root": "../demo_data",
      "epochs_dir": "epochs_demo",
      "modality": "eeg",
      "session": "rest",
      "band": null,
      "sc_path": null
    }
  },

  "bands": {"theta": [4, 8], "alpha": [8, 13], "beta": [13, 30]},

  "preprocessing": {"envelope": false, "orthogonalize": false, "tau": "FIT"},

  "models": {
    "legacy": {"sigma": 0.05, "maxC": 0.2, "use_abs": true,
               "eps_fc": 4e-4, "eps_fs": 1e-4},
    "network": {"sigma": 0.05, "theta": "FIT", "gamma": 0.8,
                "eps_fc": 1e-2, "eps_fs": 1e-1},
    "linear_hopf": {"sigma": 0.05, "maxC": 0.2, "a": -0.02,
                    "freqs_path": "../demo_data/freqs.csv",
                    "eps_fc": 4e-4, "eps_fs": 1e-4}
  },

  "fitting": {"max_iter": 2000, "tol": 1e-5, "check_every": 10,
              "convergence": "legacy", "log_every": 10, "n_init": 1,
              "seed": 0, "eps_fs_asym": 0.0, "split_half": false},

  "sweep": [
    {"_comment": "Study 2: learning rates of the network model",
     "datasets": ["demo"], "models": ["network"],
     "grid": {"eps_fc": [0.003, 0.01, 0.03], "eps_fs": [0.03, 0.1, 0.3]}},
    {"_comment": "Study 2: same rates, run to max_iter to see the full dynamics",
     "datasets": ["demo"], "models": ["network"],
     "grid": {"convergence": ["none"]}},
    {"_comment": "Study 3: the three models at their default settings",
     "datasets": ["demo"], "models": ["legacy", "network", "linear_hopf"],
     "split_half": true},
    {"_comment": "Random initialisation (no SC), averaged over 3 seeds",
     "datasets": ["demo_channels"], "models": ["network"],
     "grid": {"n_init": [3]}}
  ]
}
